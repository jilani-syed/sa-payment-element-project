<div
  id="payment-checkout"
  class="row justify-content-md-center"
  data-publishable-key="{{stripePublishableKey}}"
>
  <div class="col-6">
    <div class="text-center mt-40">
      <h1>
        Checkout — Stripe Press
      </h1>
      <h5 class="text-secondary">
        Complete your Stripe Press order
      </h5>
      <hr class="mt-40">
      <div class="mt-20 text-info">
        Total due: <span id="checkout-total">$0.00</span>
      </div>
    </div>
    <div id="checkout-error" class="alert alert-danger d-none mt-4" role="alert"></div>
    <div id="checkout-items" class="list-group mt-4" aria-label="Order items"></div>
    <div class="card box-shadow mt-40">
      <div class="card-body">
        <form id="payment-form" name="payment-form">
          <div id="customer-section">
            <div class="form-group mt-20">
              <label for="customer-email">Order email</label>
              <input
                id="customer-email"
                name="email"
                type="email"
                class="form-control"
                autocomplete="email"
                maxlength="254"
                required
              >
              <small class="form-text text-secondary">
                Used to associate this order with your Stripe customer record.
              </small>
            </div>
            <button
              id="payment-initialize"
              type="button"
              class="btn btn-block btn-primary"
            >
              Continue to payment
            </button>
          </div>

          <div id="payment-section" class="d-none">
            <div id="payment-loading" class="mt-20 text-center text-secondary" role="status">
              Loading secure payment options…
            </div>
            <div id="payment-element" class="mt-20"></div>
            <div
              id="payment-message"
              class="alert alert-danger d-none mt-3"
              role="alert"
              aria-live="polite"
            ></div>
            <div class="small text-secondary mt-3">
              Payment information is securely collected by Stripe and does not pass through this server.
            </div>
            <div class="mt-20">
              <button id="payment-submit" type="submit" class="btn btn-lg btn-block btn-primary" disabled>
                Loading payment options…
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script src="https://js.stripe.com/v3/"></script>
<script src="/js/checkout-summary.js"></script>
<script src="/js/checkout-attempt.js"></script>
<script src="/js/payment.js"></script>
